# =====================================================================
# API KEYS — copy to .env and fill in.  Never commit .env.
# (Blueprint §6.2 — "Create a .env file with your API keys")
# =====================================================================

# LLM providers
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-...

# Financial data feeds
FINNHUB_API_KEY=...
NEWS_API_KEY=...
POLYGON_API_KEY=...
ALPHAFEED_API_KEY=sk_...   # Primary A-share market data (real OHLCV)

# Free data source flags (no keys required)
BAOSTOCK_ENABLED=true
AKSHARE_ENABLED=true

# PIT database — Postgres is the production backend (docker compose up -d);
# SQLite works out of the box for local/offline runs.
PIT_DATABASE_URL=postgresql://pit:pit@localhost:5432/pit_data
# PIT_DATABASE_URL=sqlite:///data/pit_data.db

# Optional observability
LANGSMITH_API_KEY=
