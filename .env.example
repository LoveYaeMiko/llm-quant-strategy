# =====================================================================
# API KEYS — copy to .env and fill in.  Never commit .env.
# (Blueprint §6.2 — "Create a .env file with your API keys")
# =====================================================================

# LLM providers
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-...

# Financial data feeds
FINNHUB_API_KEY=...
NEWS_API_KEY=...
POLYGON_API_KEY=...

# PIT database (PostgreSQL recommended; SQLite works out of the box)
PIT_DATABASE_URL=sqlite:///data/pit_data.db

# Optional observability
LANGSMITH_API_KEY=
